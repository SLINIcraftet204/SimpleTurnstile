<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="SLINIcraftet204\SimpleTurnstile\Storefront\Framework\Captcha\SimpleTurnstileCaptcha">
            <argument key="$client" type="service" id="shopware.captcha.client"/>
            <tag name="shopware.storefront.captcha"/>
        </service>

        <service id="SLINIcraftet204\SimpleTurnstile\Subscriber\ConfigSnapshotSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
