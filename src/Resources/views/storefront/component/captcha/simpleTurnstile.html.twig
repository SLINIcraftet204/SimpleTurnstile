{% block component_captcha_simple_turnstile %}
    {% set siteKey = config('SimpleTurnstile.config.siteKey') %}
    {% set theme = config('SimpleTurnstile.config.theme') ?: 'auto' %}
    {% set size = config('SimpleTurnstile.config.size') ?: 'normal' %}
    {% set language = config('SimpleTurnstile.config.language') ?: 'auto' %}

    {% if siteKey is not empty %}
        <div class="simple-turnstile-captcha{% if additionalClass is defined and additionalClass %} {{ additionalClass }}{% endif %}"
             data-simple-turnstile="true"
             data-sitekey="{{ siteKey }}"
             data-theme="{{ theme }}"
             data-size="{{ size }}"
             data-language="{{ language }}"
             data-response-field-name="cf-turnstile-response">
            <div class="simple-turnstile-widget"
                 data-simple-turnstile-widget="true"></div>
        </div>
    {% endif %}
{% endblock %}
